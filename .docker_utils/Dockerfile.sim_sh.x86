# ICRA2026 검증용 minimal sim 이미지 — state_machine 리팩토링 검증 전용 (SH).
#
# 기존 base_x86 대비 빠진 것 (검증엔 불필요):
#   - GLIL thirdparty superbuild (GTSAM, ROBIN, gtsam_points, KISS-Matcher) — 가장 무거움 (~30분)
#   - Cartographer + abseil
#   - Livox SDK2 + driver
#   - CMake 3.28 (system default 사용)
#   - apt: linux_req_glil.txt 의 GLIL 전용 의존
#
# 결과: 빌드 5~15분 (vs 기존 base 40~60분), 컨테이너 ~3GB (vs ~10GB).
# 용도: fake_odom_publisher + state_machine + obstacle_publisher 시나리오 검증.

FROM ros:noetic-robot
SHELL [ "/bin/bash", "-c" ]

ADD ./.devcontainer/.install_utils /.install_utils
ARG DEBIAN_FRONTEND=noninteractive

# HTTPS apt mirror (port 80 차단 환경 대비 — HJ patch 그대로)
RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list

# apt 의존 (sim 전용 list — linux_req_car.txt 보다 가벼움)
RUN apt-get update && xargs apt-get install -y < /.install_utils/linux_req_sim.txt && \
    rm -rf /var/lib/apt/lists/*

# Python 의존 (state_machine + planner Python 노드들)
RUN --mount=type=cache,target=/root/.cache/pip pip3 install -r /.install_utils/requirements.txt

# catkin_tools (catkin build 용)
RUN apt-get update && apt-get install -y curl gnupg2 lsb-release && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | \
    gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" \
    > /etc/apt/sources.list.d/ros-latest.list && \
    apt-get update && apt-get install -y python3-catkin-tools && \
    rm -rf /var/lib/apt/lists/*

# 추가 검증 편의 도구 (pyflakes, vim 등)
RUN apt-get update && apt-get install -y \
    vim less iproute2 iputils-ping x11-apps sudo && \
    rm -rf /var/lib/apt/lists/*

# user setup (sim_x86 Dockerfile 과 동일)
ARG USER
ARG UID
ARG GID
RUN /bin/bash /.install_utils/setup_user.sh

USER $USER
WORKDIR /home/${USER}/catkin_ws
RUN mkdir -p /home/${USER}/catkin_ws/src

# workspace 초기화 + sim 전용 skiplist 적용
RUN catkin init && . /opt/ros/noetic/setup.bash && . /.install_utils/catkin_skiplist_sim.sh

# sudo 권한 부여 (디버깅 편의)
USER root
RUN chown -R ${USER}:${USER} /home/${USER} && \
    echo $USER ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USER && \
    chmod 0440 /etc/sudoers.d/$USER
USER $USER

ENTRYPOINT [ "bash", "/.install_utils/ros_entrypoint.sh" ]
